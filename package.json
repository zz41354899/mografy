{
  "name": "mografy-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mografy": "./packages/cli/bin/mografy.js"
  },
  "scripts": {
    "build": "pnpm --filter './packages/**' -r --workspace-concurrency=1 build && pnpm sync:skills",
    "typecheck": "pnpm --filter './packages/**' -r typecheck",
    "sync:skills": "node --import tsx scripts/sync-agent-docs.ts",
    "sync:slides": "node --import tsx scripts/sync-slides.ts",
    "thumbnails:generate": "pnpm build && node --import tsx scripts/generate-component-thumbnails.ts",
    "test": "pnpm --filter './packages/**' -r --workspace-concurrency=1 test",
    "test:browser": "pnpm --filter './packages/**' -r --workspace-concurrency=1 --if-present test:browser",
    "test:compression": "python3 -B -m unittest discover -s scripts/tests -p 'test_*.py'",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "mografy": "node packages/cli/bin/mografy.js",
    "install:tool": "pnpm install --filter mografy-workspace --filter './packages/**'",
    "postinstall": "pnpm build && playwright install chromium && node packages/cli/bin/mografy.js install-command && pnpm sync:slides",
    "bootstrap": "pnpm install",
    "install-command": "node packages/cli/bin/mografy.js install-command"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "26.6.5",
    "playwright": "1.64.0"
  }
}
