 "cues": [
  {
   "shot": "S01",
   "start": 1.6,
   "end": 3.26,
   "text": "舞台上有一盞聚光燈。"
  },
  {
   "shot": "S01",
   "start": 3.75,
   "end": 4.75,
   "text": "它照到哪裡，"
  },
  {
   "shot": "S01",
   "start": 4.97,
   "end": 5.94,
   "text": "你就看見哪裡。"
  },
  {
   "shot": "S02",
   "start": 7.44,
   "end": 8.56,
   "text": "報告明天要交，"
  },
  {
   "shot": "S02",
   "start": 8.88,
   "end": 9.85,
   "text": "燈一直滑走。"
  },
  {
   "shot": "S02",
   "start": 10.62,
   "end": 11.73,
   "text": "影集看到天亮，"
  },
  {
   "shot": "S02",
   "start": 11.91,
   "end": 12.9,
   "text": "它卻動也不動。"
  },
  {
   "shot": "S03",
   "start": 13.4,
   "end": 14.75,
   "text": "很多人說這是懶。"
  },
  {
   "shot": "S03",
   "start": 15.47,
   "end": 17.43,
   "text": "研究看到的，不太一樣。"
  },
  {
   "shot": "S04",
   "start": 17.95,
   "end": 19.55,
   "text": "三百多項研究整理出："
  },
  {
   "shot": "S04",
   "start": 19.94,
   "end": 22.59,
   "text": "ADHD 的反應，更容易忽快忽慢。"
  },
  {
   "shot": "S05",
   "start": 23.2,
   "end": 24.21,
   "text": "大腦有個後台，"
  },
  {
   "shot": "S05",
   "start": 24.49,
   "end": 25.52,
   "text": "發呆時最亮。"
  },
  {
   "shot": "S05",
   "start": 26.03,
   "end": 28.01,
   "text": "開始做事，它本該暗下來。"
  },
  {
   "shot": "S06",
   "start": 28.59,
   "end": 29.78,
   "text": "兒少腦造影看到，"
  },
  {
   "shot": "S06",
   "start": 30.11,
   "end": 32.94,
   "text": "ADHD 的前後台平均分得較不開。"
  },
  {
   "shot": "S06",
   "start": 33.26,
   "end": 34.1,
   "text": "差異很小，"
  },
  {
   "shot": "S06",
   "start": 34.37,
   "end": 35.48,
   "text": "只是線索之一。"
  },
  {
   "shot": "S07",
   "start": 36.19,
   "end": 37.57,
   "text": "獎勵也有距離。"
  },
  {
   "shot": "S07",
   "start": 38.12,
   "end": 40.11,
   "text": "對不少有 ADHD 的人來說，"
  },
  {
   "shot": "S07",
   "start": 40.32,
   "end": 42.32,
   "text": "遠處的大獎，縮得特別快。"
  },
  {
   "shot": "S08",
   "start": 42.93,
   "end": 44.23,
   "text": "有時燈鎖住不動，"
  },
  {
   "shot": "S08",
   "start": 44.56,
   "end": 45.88,
   "text": "一抬頭，天亮了。"
  },
  {
   "shot": "S08",
   "start": 46.36,
   "end": 47.48,
   "text": "這叫過度專注，"
  },
  {
   "shot": "S08",
   "start": 47.75,
   "end": 49.13,
   "text": "不是 ADHD 獨有。"
  },
  {
   "shot": "S09",
   "start": 49.79,
   "end": 51.13,
   "text": "至於那句「坐好」："
  },
  {
   "shot": "S09",
   "start": 51.7,
   "end": 52.84,
   "text": "一項小型研究裡，"
  },
  {
   "shot": "S09",
   "start": 53.02,
   "end": 55.18,
   "text": "有 ADHD 的男孩動得多時，"
  },
  {
   "shot": "S09",
   "start": 55.36,
   "end": 56.65,
   "text": "記憶題答得更好。"
  },
  {
   "shot": "S10",
   "start": 57.12,
   "end": 59.96,
   "text": "基因、環境、大腦發展一起作用。"
  },
  {
   "shot": "S10",
   "start": 60.36,
   "end": 62.43,
   "text": "一句「不夠努力」解釋不了。"
  },
  {
   "shot": "S11",
   "start": 63.08,
   "end": 66.55,
   "text": "藥物、心理治療、環境調整，都是選項。"
  },
  {
   "shot": "S11",
   "start": 67.04,
   "end": 69.24,
   "text": "怎麼搭配，找專業人員一起看。"
  },
  {
   "shot": "S12",
   "start": 69.8,
   "end": 71.89,
   "text": "偶爾分心，不等於 ADHD。"
  },
  {
   "shot": "S12",
   "start": 72.39,
   "end": 73.89,
   "text": "要看是否從小就有、"
  },
  {
   "shot": "S12",
   "start": 74.12,
   "end": 76.17,
   "text": "跨場合，而且影響生活。"
  },
  {
   "shot": "S13",
   "start": 77.39,
   "end": 78.87,
   "text": "這盞燈不是不亮。"
  },
  {
   "shot": "S13",
   "start": 79.31,
   "end": 80.07,
   "text": "只是，"
  },
  {
   "shot": "S13",
   "start": 80.55,
   "end": 81.38,
   "text": "比較難調度。"
  }
 ]
}