 "cues": [
  {
   "shot": "S01",
   "start": 1.34,
   "end": 3.72,
   "text": "一個人拉繩子，能出多少力？",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 5.18,
   "end": 8.09,
   "text": "一百多年前，法國農業工程師林格曼，",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 8.39,
   "end": 10.06,
   "text": "量過人拉繩子的力氣。",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 10.8,
   "end": 12.3,
   "text": "一個人出一百分的力。",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 12.92,
   "end": 15.19,
   "text": "兩個人一起，每人只剩 93；",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 15.64,
   "end": 16.95,
   "text": "三個人，85。",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 17.52,
   "end": 18.33,
   "text": "到了八個人，",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 18.57,
   "end": 20.37,
   "text": "每個人平均只出了 49，",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 20.65,
   "end": 21.2,
   "text": "不到一半。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 21.96,
   "end": 24.17,
   "text": "人越多，每個人出的力越少。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 24.74,
   "end": 26.53,
   "text": "這就叫「林格曼效應」。",
   "role": "title"
  },
  {
   "shot": "S06",
   "start": 28.17,
   "end": 31.09,
   "text": "林格曼猜，是大家用力的時間對不上。",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 31.95,
   "end": 34.9,
   "text": "但 1974 年的實驗讓人蒙眼拉繩，",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 35.28,
   "end": 37.08,
   "text": "後面的人只是假裝在拉。",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 37.53,
   "end": 38.61,
   "text": "不用配合任何人，",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 38.88,
   "end": 40.1,
   "text": "他還是少出了力。",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 41.11,
   "end": 44.13,
   "text": "1979 年，研究者讓人戴上耳機大喊。",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 44.77,
   "end": 47.3,
   "text": "只要以為有人一起喊，聲音就變小。",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 47.76,
   "end": 49.09,
   "text": "這叫「社會懈怠」。",
   "role": "sub"
  },
  {
   "shot": "S09",
   "start": 49.92,
   "end": 52.6,
   "text": "人一多，沒人看得出你出了多少力；",
   "role": "sub"
  },
  {
   "shot": "S09",
   "start": 53.08,
   "end": 54.83,
   "text": "你也覺得，少你一個沒差。",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 55.76,
   "end": 59.27,
   "text": "1993 年，一份整理 78 篇研究的分析發現：",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 59.81,
   "end": 61.48,
   "text": "當每個人的貢獻看得見、",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 61.8,
   "end": 62.74,
   "text": "任務有意義、",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 63.0,
   "end": 63.86,
   "text": "團隊小一點、",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 64.16,
   "end": 64.91,
   "text": "彼此在乎，",
   "role": "sub"
  },
  {
   "shot": "S11",
   "start": 65.22,
   "end": 66.65,
   "text": "偷懶就會少很多。",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 67.32,
   "end": 69.0,
   "text": "人多，不一定力量大；",
   "role": "tag"
  },
  {
   "shot": "S12",
   "start": 69.43,
   "end": 69.98,
   "text": "看得見，",
   "role": "tag"
  },
  {
   "shot": "S12",
   "start": 70.29,
   "end": 71.39,
   "text": "大家才會用力。",
   "role": "tag"
  }
 ]
}