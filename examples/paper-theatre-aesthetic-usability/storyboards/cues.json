 "cues": [
  {
   "shot": "S01",
   "start": 1.29,
   "end": 2.47,
   "text": "這兩台機器，",
   "role": "sub"
  },
  {
   "shot": "S01",
   "start": 2.72,
   "end": 3.68,
   "text": "功能一模一樣。",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 4.25,
   "end": 5.37,
   "text": "唯一的差別是：",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 5.7,
   "end": 6.55,
   "text": "一台比較好看。",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 7.3,
   "end": 9.16,
   "text": "同樣的按鈕，同樣的步驟，",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 9.66,
   "end": 10.97,
   "text": "可是大多數人會說，",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 11.28,
   "end": 12.74,
   "text": "右邊那台比較好用。",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 13.84,
   "end": 14.72,
   "text": "1995 年，",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 14.96,
   "end": 19.48,
   "text": "日立的研究者請 252 個人評比 26 種 ATM 畫面。",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 20.14,
   "end": 21.58,
   "text": "結果，看起來越美，",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 21.89,
   "end": 23.18,
   "text": "大家就越覺得好用。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 23.83,
   "end": 25.84,
   "text": "這叫做「美即好用效應」。",
   "role": "title"
  },
  {
   "shot": "S06",
   "start": 27.06,
   "end": 28.77,
   "text": "更有趣的是出錯的時候。",
   "role": "sub"
  },
  {
   "shot": "S06",
   "start": 29.45,
   "end": 32.48,
   "text": "同一個小錯誤，在醜的介面上讓人火大；",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 33.08,
   "end": 35.76,
   "text": "在好看的介面上，人卻比較願意原諒。",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 36.54,
   "end": 37.24,
   "text": "諾曼說，",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 37.57,
   "end": 39.62,
   "text": "好看的東西讓人心情變好；",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 40.12,
   "end": 43.79,
   "text": "心情好，就更有耐心，也更願意自己找出解法。",
   "role": "sub"
  },
  {
   "shot": "S09",
   "start": 44.69,
   "end": 46.42,
   "text": "第一眼的好感就像光環，",
   "role": "sub"
  },
  {
   "shot": "S09",
   "start": 46.78,
   "end": 48.42,
   "text": "會一路影響後面的判斷。",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 49.91,
   "end": 51.69,
   "text": "但光環只撐得住小問題。",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 52.57,
   "end": 53.4,
   "text": "真的不好用，",
   "role": "sub"
  },
  {
   "shot": "S10",
   "start": 53.76,
   "end": 55.52,
   "text": "再好看，人也會離開。",
   "role": "sub"
  },
  {
   "shot": "S11",
   "start": 56.41,
   "end": 57.85,
   "text": "好看還有一個副作用：",
   "role": "sub"
  },
  {
   "shot": "S11",
   "start": 58.4,
   "end": 60.59,
   "text": "它會讓測試的人，看不見問題。",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 61.57,
   "end": 64.05,
   "text": "所以，美不是用來遮住問題，",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 64.39,
   "end": 66.62,
   "text": "而是讓人願意，多給一次機會。",
   "role": "sub"
  },
  {
   "shot": "S13",
   "start": 67.45,
   "end": 68.67,
   "text": "好看讓人留步，",
   "role": "tag"
  },
  {
   "shot": "S13",
   "start": 69.13,
   "end": 70.47,
   "text": "好用讓人留下。",
   "role": "tag"
  }
