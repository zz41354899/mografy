 "cues": [
  {
   "shot": "S01",
   "start": 1.48,
   "end": 2.32,
   "text": "這些碎片，",
   "role": "sub"
  },
  {
   "shot": "S01",
   "start": 2.97,
   "end": 3.85,
   "text": "看起來像什麼？",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 4.9,
   "end": 5.52,
   "text": "燈一停，",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 5.79,
   "end": 7.2,
   "text": "碎片就成了一張臉。",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 7.86,
   "end": 8.65,
   "text": "考夫卡說：",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 9.07,
   "end": 11.23,
   "text": "整體，不等於部分的總和。",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 12.12,
   "end": 14.1,
   "text": "1912 年，魏泰默發現：",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 14.54,
   "end": 16.1,
   "text": "兩盞燈輪流亮起，",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 16.4,
   "end": 18.32,
   "text": "大腦卻看見一隻鳥在飛。",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 19.01,
   "end": 19.67,
   "text": "同一張圖，",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 19.99,
   "end": 21.84,
   "text": "你看到花瓶，還是兩張臉？",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 22.73,
   "end": 25.23,
   "text": "大腦一次，只能選一個當主角。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 26.11,
   "end": 28.29,
   "text": "大腦拼圖，有幾個常見的習慣。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 29.04,
   "end": 30.25,
   "text": "第一，接近：",
   "role": "step"
  },
  {
   "shot": "S05",
   "start": 30.7,
   "end": 32.28,
   "text": "靠在一起的，就是一組。",
   "role": "step"
  },
  {
   "shot": "S06",
   "start": 32.97,
   "end": 34.17,
   "text": "第二，相似：",
   "role": "step"
  },
  {
   "shot": "S06",
   "start": 34.59,
   "end": 36.61,
   "text": "長得像的，會被看成同一類。",
   "role": "step"
  },
  {
   "shot": "S07",
   "start": 37.26,
   "end": 38.41,
   "text": "第三，封閉：",
   "role": "step"
  },
  {
   "shot": "S07",
   "start": 38.82,
   "end": 40.99,
   "text": "缺了一角，大腦會自己補上。",
   "role": "step"
  },
  {
   "shot": "S07",
   "start": 41.74,
   "end": 43.82,
   "text": "這個三角形，其實不存在。",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 44.56,
   "end": 45.78,
   "text": "第四，連續：",
   "role": "step"
  },
  {
   "shot": "S08",
   "start": 46.25,
   "end": 48.91,
   "text": "線條會順著最平滑的方向走下去。",
   "role": "step"
  },
  {
   "shot": "S09",
   "start": 49.58,
   "end": 51.06,
   "text": "第五，共同命運：",
   "role": "step"
  },
  {
   "shot": "S09",
   "start": 51.47,
   "end": 53.32,
   "text": "一起移動的，就是同一群。",
   "role": "step"
  },
  {
   "shot": "S10",
   "start": 53.9,
   "end": 56.18,
   "text": "第六，簡潔，也叫完形：",
   "role": "step"
  },
  {
   "shot": "S10",
   "start": 56.64,
   "end": 58.72,
   "text": "大腦總是選最簡單的解釋。",
   "role": "step"
  },
  {
   "shot": "S11",
   "start": 59.85,
   "end": 61.69,
   "text": "換個角度，臉就散了。",
   "role": "sub"
  },
  {
   "shot": "S11",
   "start": 62.39,
   "end": 65.87,
   "text": "我們對一個人的印象，也常是幾片碎片拼出來的。",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 66.55,
   "end": 68.62,
   "text": "所以，你不是在看世界，",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 68.96,
   "end": 70.11,
   "text": "你是在完成它。",
   "role": "sub"
  },
  {
   "shot": "S13",
   "start": 70.66,
   "end": 72.83,
   "text": "你看見的，是大腦完成的。",
   "role": "tag"
  }
 ]
}