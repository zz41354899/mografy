 "cues": [
  {
   "shot": "S01",
   "start": 1.0,
   "end": 3.17,
   "text": "燈亮的地方，就有影子。",
   "role": "sub"
  },
  {
   "shot": "S01",
   "start": 4.04,
   "end": 7.2,
   "text": "榮格說：每個人，都帶著一道陰影。",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 7.92,
   "end": 10.52,
   "text": "陰影，是你不願承認的那部分自己——",
   "role": "sub"
  },
  {
   "shot": "S02",
   "start": 11.18,
   "end": 14.85,
   "text": "憤怒、嫉妒、脆弱，和說不出口的渴望。",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 15.93,
   "end": 16.89,
   "text": "它不是天生的。",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 17.66,
   "end": 20.6,
   "text": "小時候，每一句「不准哭」、「不要生氣」，",
   "role": "sub"
  },
  {
   "shot": "S03",
   "start": 21.12,
   "end": 23.36,
   "text": "都把一部分的我們，推到了身後。",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 25.08,
   "end": 27.55,
   "text": "長大以後，我們學會戴上面具，",
   "role": "sub"
  },
  {
   "shot": "S04",
   "start": 27.85,
   "end": 30.33,
   "text": "只把討人喜歡的那一面，留給別人看。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 31.12,
   "end": 33.31,
   "text": "但被藏起來的，並不會消失。",
   "role": "sub"
  },
  {
   "shot": "S05",
   "start": 34.41,
   "end": 36.89,
   "text": "它會投射出去——落在別人身上。",
   "role": "sub"
  },
  {
   "shot": "S06",
   "start": 37.65,
   "end": 39.28,
   "text": "當某個人特別讓你火大，",
   "role": "sub"
  },
  {
   "shot": "S06",
   "start": 39.69,
   "end": 42.0,
   "text": "那份刺痛，常常指向你自己。",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 43.52,
   "end": 45.53,
   "text": "要停止投射，只有一個方法：",
   "role": "sub"
  },
  {
   "shot": "S07",
   "start": 46.13,
   "end": 47.75,
   "text": "轉過身……看見它。",
   "role": "sub"
  },
  {
   "shot": "S08",
   "start": 48.68,
   "end": 50.04,
   "text": "第一步，覺察。",
   "role": "step"
  },
  {
   "shot": "S08",
   "start": 50.66,
   "end": 52.77,
   "text": "留意那些讓你反應過度的時刻。",
   "role": "step"
  },
  {
   "shot": "S09",
   "start": 53.6,
   "end": 54.84,
   "text": "第二步，接納。",
   "role": "step"
  },
  {
   "shot": "S09",
   "start": 55.38,
   "end": 57.59,
   "text": "叫出它的名字，不急著趕走它。",
   "role": "step"
  },
  {
   "shot": "S10",
   "start": 58.4,
   "end": 59.78,
   "text": "第三步，整合。",
   "role": "step"
  },
  {
   "shot": "S10",
   "start": 60.31,
   "end": 62.33,
   "text": "把它的力量，收回成自己的。",
   "role": "step"
  },
  {
   "shot": "S11",
   "start": 63.06,
   "end": 64.66,
   "text": "陰影裡，不只有黑暗。",
   "role": "sub"
  },
  {
   "shot": "S11",
   "start": 65.15,
   "end": 68.65,
   "text": "憤怒裡有力量，嫉妒，指向你真正想要的。",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 69.36,
   "end": 71.24,
   "text": "目標從來不是消滅影子，",
   "role": "sub"
  },
  {
   "shot": "S12",
   "start": 71.65,
   "end": 74.11,
   "text": "而是讓光和影，屬於同一個人。",
   "role": "sub"
  },
  {
   "shot": "S13",
   "start": 74.97,
   "end": 76.69,
   "text": "與你的影子，和解。",
   "role": "tag"
  }
 ]
}